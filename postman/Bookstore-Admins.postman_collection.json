{
  "info": {
    "_postman_id": "25efce77-cc66-4fbc-9eac-7db9f10c6674",
    "name": "Bookstore - Admin Management",
    "description": "Executable administrator-management checks. No Postman environment is required. Start the API with the dev seed credentials, update collection variables if needed, and run folders in numbered order. Authentication saves tokens and Create ADMIN generates a unique email and saves createdAdminId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "adminEmail", "value": "admin@bookstore.local" },
    { "key": "adminPassword", "value": "Admin123" },
    { "key": "userEmail", "value": "user@bookstore.local" },
    { "key": "userPassword", "value": "User123" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "newAdminEmail", "value": "" },
    { "key": "newAdminPassword", "value": "Password123" },
    { "key": "newAdminPhone", "value": "+201009876543" },
    { "key": "createdAdminId", "value": "" },
    { "key": "missingAdminId", "value": "999999999" }
  ],
  "item": [
    {
      "name": "1 - Authentication",
      "description": "Captures the seeded ADMIN and USER tokens used by later authorization checks.",
      "item": [
        {
          "name": "Login ADMIN - save adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"adminToken\", body.token);",
                  "    pm.test(\"Role is ADMIN\", function () { pm.expect(body.role).to.eql(\"ADMIN\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login USER - save userToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"userToken\", body.token);",
                  "    pm.test(\"Role is USER\", function () { pm.expect(body.role).to.eql(\"USER\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Current account is ADMIN\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.include.keys(\"id\", \"email\", \"phone\", \"role\");",
                  "    pm.expect(body.role).to.eql(\"ADMIN\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "2 - Admin CRUD Happy Path",
      "description": "Creates a uniquely named administrator, lists it, verifies duplicate protection, and deletes it.",
      "item": [
        {
          "name": "Create ADMIN - save createdAdminId",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set(\"newAdminEmail\", `postman-admin-${Date.now()}@example.com`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"createdAdminId\", body.id);",
                  "    pm.test(\"Created account is ADMIN\", function () {",
                  "        pm.expect(body).to.include.keys(\"id\", \"email\", \"phone\", \"role\");",
                  "        pm.expect(body.email).to.eql(pm.collectionVariables.get(\"newAdminEmail\"));",
                  "        pm.expect(body.role).to.eql(\"ADMIN\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\",\n  \"phone\": \"{{newAdminPhone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "List ADMINs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is an ADMIN array containing the created account\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    body.forEach(function (account) { pm.expect(account.role).to.eql(\"ADMIN\"); });",
                  "    pm.expect(body.some(function (account) { return String(account.id) === String(pm.collectionVariables.get(\"createdAdminId\")); })).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "Create duplicate ADMIN returns 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\",\n  \"phone\": \"{{newAdminPhone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "Delete created ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admins/{{createdAdminId}}"
          }
        },
        {
          "name": "Delete removed ADMIN returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admins/{{createdAdminId}}"
          }
        }
      ]
    },
    {
      "name": "3 - Validation & Authorization",
      "item": [
        {
          "name": "List ADMINs without JWT returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/admins" }
        },
        {
          "name": "List ADMINs as USER returns 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "Create ADMIN as USER returns 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"forbidden-admin@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"+201001234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "Create invalid ADMIN returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"phone\": \"123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admins"
          }
        },
        {
          "name": "Delete unknown ADMIN returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admins/{{missingAdminId}}"
          }
        }
      ]
    }
  ]
}
