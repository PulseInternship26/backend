{
  "info": {
    "_postman_id": "db23df1a-3a35-4ab3-81ec-98e1c2ca9919",
    "name": "Bookstore - Book Feature",
    "description": "Book-focused API tests. Run Setup & Authentication first. Public registration creates only USER accounts, so adminEmail/adminPassword must belong to an existing ADMIN. Login scripts save JWTs; Create Book saves bookId for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Setup & Authentication",
      "item": [
        {
          "name": "Register USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 or user already exists\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"confirmPassword\": \"{{userPassword}}\",\n  \"phone\": \"{{userPhone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login USER - save userToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"userToken\", body.token);",
                  "    pm.test(\"Role is USER\", function () { pm.expect(body.role).to.eql(\"USER\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login ADMIN - save adminToken",
          "description": "Requires an existing ADMIN account. This collection intentionally does not create or manage admins.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"adminToken\", body.token);",
                  "    pm.test(\"Role is ADMIN\", function () { pm.expect(body.role).to.eql(\"ADMIN\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2 - Book CRUD Happy Path",
      "item": [
        {
          "name": "GET all books as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is a summary array\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    if (body.length > 0) pm.expect(body[0]).not.to.have.property(\"description\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "POST create book as ADMIN - save bookId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"bookId\", body.id);",
                  "    pm.test(\"Created response contains detail fields\", function () {",
                  "        pm.expect(body).to.include.keys(\"id\", \"title\", \"author\", \"category\", \"price\", \"description\", \"imageUrl\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software Engineering\",\n  \"price\": 29.99,\n  \"description\": \"A practical guide to writing maintainable code.\",\n  \"imageUrl\": \"https://example.com/clean-code.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "GET created book as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returned ID matches bookId\", function () {",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get(\"bookId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "PUT update book as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Book was updated\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.title).to.eql(\"Clean Code - Updated\");",
                  "    pm.expect(body.price).to.eql(34.99);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code - Updated\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software Engineering\",\n  \"price\": 34.99,\n  \"description\": \"An updated test description.\",\n  \"imageUrl\": \"https://example.com/clean-code-updated.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "DELETE book as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "GET deleted book returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Standard error shape\", function () {",
                  "    pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "3 - Validation & Authorization",
      "item": [
        {
          "name": "GET books without JWT returns 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books" }
        },
        {
          "name": "POST book as USER returns 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden Book\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": 10.00,\n  \"description\": \"This request must not create a book.\",\n  \"imageUrl\": \"https://example.com/forbidden.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "POST invalid book as ADMIN returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Standard error shape\", function () {",
                  "    pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": -1,\n  \"description\": \"Invalid test book\",\n  \"imageUrl\": \"https://example.com/invalid.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "GET unknown book returns 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        }
      ]
    }
  ]
}
