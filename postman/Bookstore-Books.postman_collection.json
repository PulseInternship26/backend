{
  "info": {
    "_postman_id": "db23df1a-3a35-4ab3-81ec-98e1c2ca9919",
    "name": "Bookstore - Authentication & Books",
    "description": "Executable authentication and book API checks. No Postman environment is required. Start the API with the dev seed credentials, update collection variables if needed, and run folders in numbered order. Login and create requests save tokens and bookId for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "userEmail", "value": "postman-user@example.com" },
    { "key": "userPassword", "value": "Password123" },
    { "key": "userPhone", "value": "+201001234567" },
    { "key": "adminEmail", "value": "admin@bookstore.local" },
    { "key": "adminPassword", "value": "Admin123" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "bookId", "value": "" },
    { "key": "missingBookId", "value": "999999999" }
  ],
  "item": [
    {
      "name": "1 - Authentication",
      "description": "Registers a reusable USER, captures USER and ADMIN tokens, and verifies the current-user endpoint.",
      "item": [
        {
          "name": "Register USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 or user already exists\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Response has the expected shape\", function () {",
                  "    const body = pm.response.json();",
                  "    if (pm.response.code === 201) {",
                  "        pm.expect(body).to.include.keys(\"id\", \"email\", \"phone\", \"role\");",
                  "        pm.expect(body.role).to.eql(\"USER\");",
                  "    } else {",
                  "        pm.expect(body).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"confirmPassword\": \"{{userPassword}}\",\n  \"phone\": \"{{userPhone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Public registration always creates a USER. The 409 assertion makes this setup request safe to rerun."
          }
        },
        {
          "name": "Login USER - save userToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"userToken\", body.token);",
                  "    pm.test(\"Login response is a USER token\", function () {",
                  "        pm.expect(body).to.include.keys(\"token\", \"email\", \"role\", \"expiresIn\");",
                  "        pm.expect(body.role).to.eql(\"USER\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Current account is the logged-in USER\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.include.keys(\"id\", \"email\", \"phone\", \"role\");",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
                  "    pm.expect(body.role).to.eql(\"USER\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "Login ADMIN - save adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"adminToken\", body.token);",
                  "    pm.test(\"Login response is an ADMIN token\", function () {",
                  "        pm.expect(body).to.include.keys(\"token\", \"email\", \"role\", \"expiresIn\");",
                  "        pm.expect(body.role).to.eql(\"ADMIN\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Defaults to the ADMIN created by DevDataSeeder."
          }
        },
        {
          "name": "Login with wrong password returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Error has the standard shape\", function () {",
                  "    pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"DefinitelyWrong123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Registration password mismatch returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error has the standard shape\", function () {",
                  "    pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mismatch@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Different123\",\n  \"phone\": \"+201001234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
    {
      "name": "2 - Book CRUD Happy Path",
      "description": "Uses the tokens from folder 1. Create Book stores bookId for the detail, update, and delete checks.",
      "item": [
        {
          "name": "List books as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response contains book summaries\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    if (body.length > 0) {",
                  "        pm.expect(body[0]).to.include.keys(\"id\", \"title\", \"author\", \"category\", \"price\", \"imageUrl\");",
                  "        pm.expect(body[0]).not.to.have.property(\"description\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Create book as ADMIN - save bookId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"bookId\", body.id);",
                  "    pm.test(\"Created response contains full book details\", function () {",
                  "        pm.expect(body).to.include.keys(\"id\", \"title\", \"author\", \"category\", \"price\", \"description\", \"imageUrl\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software Engineering\",\n  \"price\": 29.99,\n  \"description\": \"A practical guide to writing maintainable code.\",\n  \"imageUrl\": \"https://example.com/clean-code.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get created book as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returned details match bookId\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get(\"bookId\")));",
                  "    pm.expect(body).to.have.property(\"description\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "Update book as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Book was updated\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.title).to.eql(\"Clean Code - Updated\");",
                  "    pm.expect(body.price).to.eql(34.99);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code - Updated\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software Engineering\",\n  \"price\": 34.99,\n  \"description\": \"An updated collection test description.\",\n  \"imageUrl\": \"https://example.com/clean-code-updated.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "Delete book as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "Get deleted book returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Error has the standard shape\", function () {",
                  "    pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "3 - Validation & Authorization",
      "item": [
        {
          "name": "List books without JWT returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books" }
        },
        {
          "name": "Create book as USER returns 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden Book\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": 10.00,\n  \"description\": \"This request must not create a book.\",\n  \"imageUrl\": \"https://example.com/forbidden.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Update book as USER returns 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden Update\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": 10.00,\n  \"description\": \"A USER cannot update books.\",\n  \"imageUrl\": \"https://example.com/forbidden.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        },
        {
          "name": "Delete book as USER returns 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        },
        {
          "name": "Create invalid book as ADMIN returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error has the standard shape\", function () { pm.expect(pm.response.json()).to.include.keys(\"status\", \"message\", \"timestamp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": -1,\n  \"description\": \"Invalid test book\",\n  \"imageUrl\": \"https://example.com/invalid.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get unknown book returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        },
        {
          "name": "Update unknown book as ADMIN returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing Book\",\n  \"author\": \"Test Author\",\n  \"category\": \"Test\",\n  \"price\": 10.00,\n  \"description\": \"The target does not exist.\",\n  \"imageUrl\": \"https://example.com/missing.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        },
        {
          "name": "Delete unknown book as ADMIN returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/books/{{missingBookId}}"
          }
        }
      ]
    }
  ]
}
