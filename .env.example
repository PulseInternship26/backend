SPRING_PROFILES_ACTIVE=dev

DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/bookstore
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password

# Generate a unique Base64-encoded secret that is at least 32 bytes after decoding.
# Example format: JWT_SECRET=<your-base64-encoded-local-secret>
JWT_SECRET=replace-with-a-base64-encoded-secret
JWT_TTL=3600

# DevDataSeeder fixes the test emails as:
#   ADMIN: admin@bookstore.local
#   USER:  user@bookstore.local
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_USER_PASSWORD=replace-with-local-user-password
