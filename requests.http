Authorization: Bearer {{user_token}}

{
  "email": "forbidden-admin@example.com",
  "password": "Password123",
  "phone": "+201001234573"
}

### USER attempts to delete ADMIN
### Expected: 403
DELETE {{host}}/api/admins/{{missingAdminId}}
Authorization: Bearer {{user_token}}

### Create ADMIN with invalid email
### Expected: 400
POST {{host}}/api/admins
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "invalid-email",
  "password": "Password123",
  "phone": "+201001234574"
}

### Create ADMIN with short password
### Expected: 400
POST {{host}}/api/admins
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "short-admin@example.com",
  "password": "short",
  "phone": "+201001234575"
}

### Create ADMIN with invalid phone
### Expected: 400
POST {{host}}/api/admins
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "phone-admin@example.com",
  "password": "Password123",
  "phone": "abc"
}

### Delete unknown ADMIN as ADMIN
### Expected: 404
DELETE {{host}}/api/admins/{{missingAdminId}}
Authorization: Bearer {{admin_token}}

