###
### Bookstore API - Combined HTTP Client Collection
###
### Run setup requests in order before requests that use captured variables.
### Dynamic variables captured by scripts:
###   user_token, admin_token, book_id, created_admin_id
###

@host = http://localhost:8081
@userEmail = user@example.com
@userPassword = Password123
@userPhone = +201001234567
@adminEmail = admin@bookstore.local
@adminPassword = Admin123
@missingBookId = 999999999
@missingAdminId = 999999999

###############################################################################
# 1. AUTHENTICATION SETUP
###############################################################################

### Register USER
### Expected: 201 on first run, 409 if the user already exists
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "confirmPassword": "{{userPassword}}",
  "phone": "{{userPhone}}"
}

> {%
    client.test("Registration succeeds or user already exists", function () {
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409, got " + response.status);
    });
%}

### Login USER and save user_token
### Expected: 200, role USER
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

> {%
    client.test("USER login returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.global.set("user_token", response.body.token);
        client.test("Login role is USER", function () {
            client.assert(response.body.role === "USER", "Expected USER role");
        });
    }
%}

### Login ADMIN and save admin_token
### Defaults to the ADMIN created by DevDataSeeder.
### Expected: 200, role ADMIN
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("ADMIN login returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.global.set("admin_token", response.body.token);
        client.test("Login role is ADMIN", function () {
            client.assert(response.body.role === "ADMIN", "Expected ADMIN role");
        });
    }
%}

###############################################################################
# 2. REGISTRATION AND LOGIN VALIDATION
###############################################################################

### Duplicate email
### Expected: 409
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "confirmPassword": "{{userPassword}}",
  "phone": "{{userPhone}}"
}

### Non-matching passwords
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "mismatch@example.com",
  "password": "Password123",
  "confirmPassword": "Different123",
  "phone": "+201001234568"
}

### Invalid registration email
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "Password123",
  "confirmPassword": "Password123",
  "phone": "+201001234569"
}

### Short registration password
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "short@example.com",
  "password": "short",
  "confirmPassword": "short",
  "phone": "+201001234570"
}

### Missing required phone
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "missing@example.com",
  "password": "Password123",
  "confirmPassword": "Password123"
}

### Invalid phone
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "phone@example.com",
  "password": "Password123",
  "confirmPassword": "Password123",
  "phone": "abc"
}

### Malformed registration JSON
### Expected: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "broken@example.com",
  "password":
}

### Attempt arbitrary ADMIN role during public registration
### Expected: 201 with role USER, or 409 if rerun
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "attempted-admin@example.com",
  "password": "Password123",
  "confirmPassword": "Password123",
  "phone": "+201001234571",
  "role": "ADMIN"
}

### Login with wrong password
### Expected: 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "WrongPassword123"
}

### Login with nonexistent email
### Expected: 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "does-not-exist@example.com",
  "password": "Password123"
}

### Login with invalid email format
### Expected: 400
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "Password123"
}

### Login with blank password
### Expected: 400
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": ""
}

###############################################################################
# 3. CURRENT USER AND JWT SECURITY
###############################################################################

### Get current USER
### Expected: 200 with id, email, phone, role
GET {{host}}/api/users/me
Authorization: Bearer {{user_token}}

### Get current user without JWT
### Expected: 401
GET {{host}}/api/users/me

### Get current user with invalid JWT
### Expected: 401
GET {{host}}/api/users/me
Authorization: Bearer invalid-token

### Get books without JWT
### Expected: 401
GET {{host}}/api/books

###############################################################################
# 4. BOOK CRUD HAPPY PATH
###############################################################################

### Get all books as USER
### Expected: 200 summary array without description
GET {{host}}/api/books
Authorization: Bearer {{user_token}}

> {%
    client.test("Book list returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Book list is an array", function () {
        client.assert(Array.isArray(response.body), "Expected an array");
    });
    if (Array.isArray(response.body) && response.body.length > 0) {
        client.test("Book summary omits description", function () {
            client.assert(response.body[0].description === undefined,
                "Summary response should not contain description");
        });
    }
%}

### Create book as ADMIN and save book_id
### Expected: 201
POST {{host}}/api/books
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "category": "Software Engineering",
  "price": 29.99,
  "description": "A practical guide to writing maintainable code.",
  "imageUrl": "https://example.com/clean-code.jpg"
}

> {%
    client.test("Book creation returns 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    if (response.status === 201) {
        client.global.set("book_id", response.body.id);
        client.test("Created book contains detail fields", function () {
            ["id", "title", "author", "category", "price", "description", "imageUrl"]
                .forEach(function (field) {
                    client.assert(response.body[field] !== undefined,
                        "Missing response field: " + field);
                });
        });
    }
%}

### Get created book as USER
### Expected: 200
GET {{host}}/api/books/{{book_id}}
Authorization: Bearer {{user_token}}

> {%
    client.test("Created book is returned", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(String(response.body.id) === String(client.global.get("book_id")),
            "Returned book ID does not match captured book_id");
    });
%}

### Update book as ADMIN
### Expected: 200
PUT {{host}}/api/books/{{book_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Clean Code - Updated",
  "author": "Robert C. Martin",
  "category": "Software Engineering",
  "price": 34.99,
  "description": "An updated test description.",
  "imageUrl": "https://example.com/clean-code-updated.jpg"
}

> {%
    client.test("Book update returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.title === "Clean Code - Updated", "Title was not updated");
        client.assert(response.body.price === 34.99, "Price was not updated");
    });
%}

### Delete book as ADMIN
### Expected: 204
DELETE {{host}}/api/books/{{book_id}}
Authorization: Bearer {{admin_token}}

### Get deleted book as USER
### Expected: 404
GET {{host}}/api/books/{{book_id}}
Authorization: Bearer {{user_token}}

###############################################################################
# 5. BOOK VALIDATION AND AUTHORIZATION
###############################################################################

### USER attempts to create book
### Expected: 403 with ErrorResponse
POST {{host}}/api/books
Content-Type: application/json
Authorization: Bearer {{user_token}}

{
  "title": "Forbidden Book",
  "author": "Test Author",
  "category": "Test",
  "price": 10.00,
  "description": "This request must not create a book.",
  "imageUrl": "https://example.com/forbidden.jpg"
}

### Create invalid book as ADMIN
### Expected: 400
POST {{host}}/api/books
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "",
  "author": "Test Author",
  "category": "Test",
  "price": -1,
  "description": "Invalid test book",
  "imageUrl": "https://example.com/invalid.jpg"
}

### Create zero-price book as ADMIN
### Expected: 400
POST {{host}}/api/books
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Zero Price Book",
  "author": "Test Author",
  "category": "Test",
  "price": 0,
  "description": "Price must be greater than zero.",
  "imageUrl": "https://example.com/zero-price.jpg"
}

### Get unknown book as USER
### Expected: 404
GET {{host}}/api/books/{{missingBookId}}
Authorization: Bearer {{user_token}}

### Update unknown book as ADMIN
### Expected: 404
PUT {{host}}/api/books/{{missingBookId}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "Missing Book",
  "author": "Test Author",
  "category": "Test",
  "price": 10.00,
  "description": "This book does not exist.",
  "imageUrl": "https://example.com/missing.jpg"
}

### Delete unknown book as ADMIN
### Expected: 404
DELETE {{host}}/api/books/{{missingBookId}}
Authorization: Bearer {{admin_token}}

###############################################################################
# 6. ADMIN MANAGEMENT HAPPY PATH
###############################################################################

### Get all admins as ADMIN
### Expected: 200
GET {{host}}/api/admins
Authorization: Bearer {{admin_token}}

### Create ADMIN and save created_admin_id
### Expected: 201, assigned role ADMIN
POST {{host}}/api/admins
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "new-admin@example.com",
  "password": "Password123",
  "phone": "+201001234572"
}

> {%
    client.test("Admin creation returns 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    if (response.status === 201) {
        client.global.set("created_admin_id", response.body.id);
        client.test("Created account has ADMIN role", function () {
            client.assert(response.body.role === "ADMIN", "Expected ADMIN role");
        });
    }
%}

### Get all admins after creation
### Expected: 200, list includes new-admin@example.com
GET {{host}}/api/admins
Authorization: Bearer {{admin_token}}

### Create duplicate ADMIN
### Expected: 409
POST {{host}}/api/admins
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "new-admin@example.com",
  "password": "Password123",
  "phone": "+201001234572"
}

### Delete created ADMIN
### Expected: 204
DELETE {{host}}/api/admins/{{created_admin_id}}
Authorization: Bearer {{admin_token}}

### Delete the same ADMIN again
### Expected: 404
DELETE {{host}}/api/admins/{{created_admin_id}}
Authorization: Bearer {{admin_token}}

